# PostgreSQL Database Configuration
# Production: Use secure credentials from your cloud provider or secrets manager
DATABASE_URL=postgresql://username:password@host:port/database_name

# Environment File Configuration
# Optional: Override automatic .env file detection
# ENV_FILE_PATH=/path/to/your/custom/.env

# Database Connection Pool Configuration
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=30
DB_POOL_RECYCLE=3600
DB_ECHO=false

# Security Configuration
# IMPORTANT: Generate a strong random key for production!
# Use: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-generated-secret-key-here

# Environment Configuration
NODE_ENV=production
DEBUG=false

# CORS Configuration
# Comma-separated list of allowed origins
# CORS_ORIGINS=https://yourdomain.com,https://app.yourdomain.com

# Server Configuration
PORT=5000
